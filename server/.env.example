# Tencent secret info.
# [Public Cloud]
#   - TC_SECRET_ID and TC_SECRET_KEY
#       - Chinese mainland users: obtain from https://console.cloud.tencent.com/cam/capi
#       - Other regions: obtain from https://console.tencentcloud.com/cam/capi
#   - TC_SECRET_APPID is not required if you don't use ASR service
# [Private Cloud]
#   - TC_SECRET_APPID is not required
#   - TC_SECRET_ID and TC_SECRET_KEY: obtain from the key management page of your private cloud

TC_SECRET_APPID=
TC_SECRET_ID=
TC_SECRET_KEY=

# ADP-specific secret info (only required when ServiceVendor is "ChinaTencentADP")
# If empty, falls back to TC_SECRET_ID / TC_SECRET_KEY
ADP_SECRET_ID=
ADP_SECRET_KEY=


# Application configuration, supports multiple application configurations
# - Vendor: Service provider name, currently only supports Tencent
# - ApplicationId: Unique identifier for the chat application, recommended to use the vendor's appid
# - Comment: Optional display label for multi-app management (non-functional field)
# - AppKey:
#   - Chinese mainland users: obtain from https://adp.cloud.tencent.com/adp/#/app/home
#   - Other regions: obtain from https://adp.tencentcloud.com/adp/#/app/home
# - ServiceVendor: Which service vendor to use: "ChinaTencentCloud" (default) | "ChinaTencentADP" | "International" | "Private"
# - PrivateUrl: access url of the private cloud, e.g. "http://172.0.0.1", no trailing slash!
#               (only required when ServiceVendor is "Private")
# [Public Cloud - China Example]
#   {
#       "Vendor": "Tencent",
#       "ApplicationId": "",
#       "Comment": "",
#       "AppKey": ""
#   }
#
# [Public Cloud - International Example]
#   {
#       "Vendor": "Tencent",
#       "ApplicationId": "",
#       "Comment": "",
#       "AppKey": "",
#       "ServiceVendor": "International"
#   }
#
# [Private Cloud Example]
#   {
#       "Vendor": "Tencent",
#       "ApplicationId": "",
#       "Comment": "",
#       "AppKey": "",
#       "ServiceVendor": "Private",
#       "PrivateUrl": "http://172.0.0.1"
#   }

APP_CONFIGS='[
    {
        "Vendor":"Tencent",
        "ApplicationId":"",
        "Comment": "",
        "AppKey": ""
    }
]'

# Prompt suggestion / quick buttons configuration for the assist chat page.
# Structure: [{ "GroupId", "IconUrl", "Name", "SuggestionList": [{ "SuggestionId", "Title", "PromptContent" }] }]
# Each group becomes a first-level tab; clicking reveals the SuggestionList as clickable prompts.
#
# Format rules (IMPORTANT):
# 1. The whole value is wrapped by single quotes '...' (multi-line), so the JSON body itself
#    MUST NOT contain any ASCII single quote ' (U+0027). If you need to quote a phrase inside
#    PromptContent, use full-width Chinese quotes “...” / ‘...’ or just omit the quotes.
#    Otherwise dotenv (used in Docker deploy mode) will treat the inner ' as the closing quote
#    of the value, and SUGGESTION_CONFIGS will silently fall back to an empty list [].
# 2. `PromptContent` supports mention syntax `@skill:<skill-name>` / `@knowledgeBase:<kb-name>`
#    / `@tool:<tool-name>`. When the user clicks the suggestion, the mention is filled into
#    the input box and rendered as a colored chip; the referenced entity must have been
#    installed on the current agent.
# 3. `IconUrl` supports https remote images (recommended 32x32 px).
SUGGESTION_CONFIGS='[
    {
        "GroupId": "example-group-doc",
        "IconUrl": "https://cdn.example.com/icons/doc-process.png",
        "Name": "文档处理",
        "SuggestionList": [
            {
                "SuggestionId": "example-sug-001",
                "Title": "会议纪要转周报",
                "PromptContent": "请将会议纪要整理成正式项目周报，提炼关键进展、问题风险、下周计划和待办事项。"
            },
            {
                "SuggestionId": "example-sug-002",
                "Title": "发票信息提取",
                "PromptContent": "帮我创建一个“发票信息提取”Skill：上传发票图片或 PDF，自动识别发票代码、发票号码、开票日期、购买方、销售方、金额、税额，输出为结构化 JSON。"
            }
        ]
    },
    {
        "GroupId": "example-group-app",
        "IconUrl": "https://cdn.example.com/icons/app-build.png",
        "Name": "应用搭建",
        "SuggestionList": [
            {
                "SuggestionId": "example-sug-003",
                "Title": "销售数据分析助手",
                "PromptContent": "帮我创建一个销售数据分析助手的应用，支持自然语言查询销售数据、自动生成可视化图表、提供趋势预测和异常预警。@skill:example-app-manager"
            }
        ]
    }
]'

# ADP VisitorId source for chat requests.
# - NAME: use the account name as VisitorId (default)
# - CUSTOMER_ID: use the CustomerId from account-system integration as VisitorId, fallback to internal account ID
ADP_VISITOR_ID_TYPE=NAME

# ============================================================
# Common configuration (applies to both Public and Private Cloud)
# ============================================================

# you can obtain it from https://github.com/settings/applications/new
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_SECRET=

# you can obtain it from https://entra.microsoft.com
OAUTH_MICROSOFT_ENTRA_CLIENT_ID=
OAUTH_MICROSOFT_ENTRA_SECRET=
# Endpoint (optional, if you have a tenant id, default: common), see: https://learn.microsoft.com/en-us/entra/identity-platform/authentication-national-cloud
OAUTH_MICROSOFT_ENTRA_ENDPOINT=common

# Whether to automatically create an account for new users
AUTO_CREATE_ACCOUNT=false

# Trusted new-api workbench mode. When enabled, local password/customer/OAuth
# entry points are disabled and only one-time tickets from claw-control are accepted.
WORKBENCH_MODE=false
WORKBENCH_CONTROL_URL=https://workbench-control.internal:8443
WORKBENCH_SERVICE_ID=adp-backend
# Generate an independent value with: openssl rand -base64 48. This key also
# authenticates the private claw-control retention intent and signed ADP receipt;
# it never appears in a retention payload, browser response, or audit row.
WORKBENCH_SERVICE_HMAC_SECRET=
WORKBENCH_SESSION_EXPIRE_MINUTES=15
WORKBENCH_STREAM_REAUTH_SECONDS=30
WORKBENCH_CONTROL_TIMEOUT_SECONDS=10
WORKBENCH_CONTROL_MAX_RESPONSE_BYTES=1048576
WORKBENCH_APP_MIGRATION_WORKER_ENABLED=false
WORKBENCH_APP_MIGRATION_POLL_SECONDS=5
WORKBENCH_APP_MIGRATION_LEASE_SECONDS=60
WORKBENCH_ALLOW_INSECURE_CONTROL_HTTP=false
WORKBENCH_CONTROL_CA_FILE=
WORKBENCH_CONTROL_CLIENT_CERT_FILE=
WORKBENCH_CONTROL_CLIENT_KEY_FILE=
WORKBENCH_ALLOWED_CLOCK_SKEW_SECONDS=30
WORKBENCH_COOKIE_PATH=/workbench
WORKBENCH_REDIRECT_PATH=/workbench/
# Disabled by default: this legacy helper exposes a provider ASR URL to the browser.
WORKBENCH_ENABLE_HELPER_ASR=false
# File upload remains fail-closed until all values below are configured. The
# bucket must already exist, have public access disabled, and use a dedicated
# least-privilege CAM identity (object put/get only for the workbench prefix).
WORKBENCH_FILES_ENABLED=false
WORKBENCH_FILE_SCANNER_HOST=clamav
WORKBENCH_FILE_SCANNER_PORT=3310
WORKBENCH_FILE_SCANNER_TIMEOUT_SECONDS=30
WORKBENCH_FILE_SCANNER_MAX_BYTES=52428800
WORKBENCH_FILE_ABSOLUTE_MAX_BYTES=52428800
WORKBENCH_FILE_QUARANTINE_CAPACITY_BYTES=104857600
WORKBENCH_FILE_QUARANTINE_DIR=/var/lib/workbench-quarantine
WORKBENCH_FILE_MAX_CONCURRENT_UPLOADS=2
WORKBENCH_FILE_COS_REGION=
WORKBENCH_FILE_COS_BUCKET=
WORKBENCH_FILE_COS_SECRET_ID=
WORKBENCH_FILE_COS_SECRET_KEY=
WORKBENCH_FILE_URL_EXPIRE_SECONDS=300
# Required when files are enabled. Generate independently with: openssl rand -base64 32
WORKBENCH_FILE_LOCATOR_KEY=
WORKBENCH_FILE_LOCATOR_KEY_ID=v1
WORKBENCH_FILE_LOCATOR_PREVIOUS_KEYS_JSON={}
WORKBENCH_RESOURCE_OUTBOX_INTERVAL_SECONDS=5
WORKBENCH_RESOURCE_OUTBOX_BATCH_SIZE=50
WORKBENCH_VENDOR_CACHE_IDLE_SECONDS=300
WORKBENCH_VENDOR_CACHE_MAX_ENTRIES=128
WORKBENCH_INSTANCE_ID=adp-blue-1
WORKBENCH_CONTROL_EVENT_CHANNEL=claw:control:events
WORKBENCH_CONTROL_EVENT_PROCESSED_TTL_SECONDS=604800
WORKBENCH_CONTROL_EVENT_MAX_BACKOFF_SECONDS=30
WORKBENCH_CONTROL_EVENT_MAX_BYTES=65536
# Required in workbench mode before a response.completed event can be accepted.
# Generate independently with: openssl rand -base64 32
WORKBENCH_USAGE_EVIDENCE_KEY=
WORKBENCH_USAGE_EVIDENCE_KEY_ID=v1
WORKBENCH_WORKSPACE_LOCATOR_KEY=
WORKBENCH_WORKSPACE_LOCATOR_KEY_ID=v1
WORKBENCH_WORKSPACE_LOCATOR_PREVIOUS_KEYS_JSON={}
# Set only after verifying the exact suffix from a real CreateWorkspaceCredential response.
WORKBENCH_WORKSPACE_HOST_SUFFIXES=
# Independent Prometheus listener. Keep disabled outside an internal-only
# container/management network and never publish this port through Caddy.
WORKBENCH_METRICS_ENABLED=false
WORKBENCH_METRICS_HOST=127.0.0.1
WORKBENCH_METRICS_PORT=9100
# Offline scheduled tasks are local, owner-scoped and disabled by default.
# Production startup refuses any database dialect other than PostgreSQL.
WORKBENCH_SCHEDULED_TASKS_ENABLED=false
WORKBENCH_SCHEDULE_REAUTH_SECONDS=300
WORKBENCH_SCHEDULE_WORKER_INTERVAL_SECONDS=5
WORKBENCH_SCHEDULE_LEASE_SECONDS=90
WORKBENCH_SCHEDULE_BATCH_SIZE=20
WORKBENCH_SCHEDULE_MIN_INTERVAL_MINUTES=15
WORKBENCH_SCHEDULE_MAX_TASKS_PER_USER=20
WORKBENCH_SCHEDULE_MAX_DAILY_RUNS=24
WORKBENCH_SCHEDULE_MAX_PROMPT_CHARS=16000
WORKBENCH_SCHEDULE_MAX_ATTACHMENTS=10
WORKBENCH_SCHEDULE_DELEGATION_DAYS=30
WORKBENCH_SCHEDULE_MISFIRE_GRACE_SECONDS=300
# Skill binding and local connector OAuth vault. Production must mount the
# allowlist/provider JSON and all keys/secrets as files; do not paste them here.
WORKBENCH_INTEGRATIONS_ENABLED=false
WORKBENCH_INTEGRATION_ALLOWLIST_FILE=/run/config/workbench/integration-allowlist.json
WORKBENCH_OAUTH_PROVIDERS_FILE=/run/config/workbench/oauth-providers.json
WORKBENCH_OAUTH_SECRET_DIR=/run/secrets/workbench-oauth
WORKBENCH_PUBLIC_BASE_URL=https://gateway.example.com/workbench
WORKBENCH_CONNECTOR_TOKEN_KEY_FILE=/run/secrets/workbench-connector-token-key
WORKBENCH_CONNECTOR_TOKEN_KEY_ID=v1
WORKBENCH_CONNECTOR_TOKEN_PREVIOUS_KEYS_FILE=/run/secrets/workbench-connector-token-previous.json
WORKBENCH_OAUTH_STATE_KEY_FILE=/run/secrets/workbench-oauth-state-key
WORKBENCH_OAUTH_STATE_KEY_ID=v1
WORKBENCH_OAUTH_STATE_PREVIOUS_KEYS_FILE=/run/secrets/workbench-oauth-state-previous.json
WORKBENCH_OAUTH_STATE_TTL_SECONDS=300
WORKBENCH_INTEGRATION_REAUTH_SECONDS=300
WORKBENCH_OAUTH_HTTP_TIMEOUT_SECONDS=15
WORKBENCH_OAUTH_MAX_RESPONSE_BYTES=262144
WORKBENCH_OAUTH_REVOCATION_INTERVAL_SECONDS=15
WORKBENCH_OAUTH_REVOCATION_BATCH_SIZE=20
WORKBENCH_OAUTH_REVOCATION_LEASE_SECONDS=60

# Owner-scoped managed sandbox. It is disabled by default. The first release is
# intentionally fixed to no-network SANDBOX mode and TOKEN authentication.
# Credentials and the idempotency HMAC key must be mounted files, never literals.
WORKBENCH_SANDBOX_ENABLED=false
WORKBENCH_SANDBOX_CODE_ENABLED=false
WORKBENCH_SANDBOX_PTY_ENABLED=false
WORKBENCH_SANDBOX_PTY_TICKET_TTL_SECONDS=30
WORKBENCH_SANDBOX_PTY_MAX_RUNTIME_SECONDS=600
WORKBENCH_SANDBOX_PTY_REAUTH_SECONDS=15
WORKBENCH_SANDBOX_PTY_HEARTBEAT_SECONDS=10
WORKBENCH_SANDBOX_PTY_STALE_SECONDS=45
WORKBENCH_SANDBOX_PTY_REAPER_SECONDS=15
WORKBENCH_SANDBOX_PTY_GLOBAL_CAPACITY=100
WORKBENCH_SANDBOX_PTY_CUSTOMER_CAPACITY=10
WORKBENCH_SANDBOX_PTY_USER_CAPACITY=2
WORKBENCH_SANDBOX_PTY_MAX_INPUT_FRAME_BYTES=16384
WORKBENCH_SANDBOX_PTY_MAX_OUTPUT_FRAME_BYTES=32768
WORKBENCH_SANDBOX_PTY_MAX_INPUT_BYTES=1048576
WORKBENCH_SANDBOX_PTY_MAX_OUTPUT_BYTES=8388608
WORKBENCH_SANDBOX_PTY_MAX_INPUT_FRAMES_PER_SECOND=30
WORKBENCH_SANDBOX_PTY_OUTPUT_QUEUE_FRAMES=32
WORKBENCH_SANDBOX_PROVIDER=tencent_agsx
WORKBENCH_AGSX_REGION=ap-guangzhou
WORKBENCH_AGSX_DOMAIN=ap-guangzhou.tencentags.com
WORKBENCH_AGSX_CONTROL_ENDPOINT=ags.tencentcloudapi.com
WORKBENCH_AGSX_TOOL_ID=
WORKBENCH_AGSX_TOOL_NAME=
WORKBENCH_AGSX_API_KEY_FILE=/run/secrets/workbench-sandbox/agsx-api-key
WORKBENCH_AGSX_CAM_SECRET_ID_FILE=/run/secrets/workbench-sandbox/cam-secret-id
WORKBENCH_AGSX_CAM_SECRET_KEY_FILE=/run/secrets/workbench-sandbox/cam-secret-key
WORKBENCH_SANDBOX_CLIENT_TOKEN_KEY_FILE=/run/secrets/workbench-sandbox/client-token-hmac-key
WORKBENCH_SANDBOX_NETWORK_MODE=SANDBOX
WORKBENCH_SANDBOX_AUTH_MODE=TOKEN
WORKBENCH_SANDBOX_LEASE_SECONDS=30
WORKBENCH_SANDBOX_STARTS_PER_USER_MINUTE=6
WORKBENCH_SANDBOX_STARTS_PER_CUSTOMER_MINUTE=60
WORKBENCH_SANDBOX_TERMINAL_RETENTION_DAYS=30
WORKBENCH_SANDBOX_DEFAULT_TIMEOUT_SECONDS=600
WORKBENCH_SANDBOX_HARD_MAX_RUNTIME_SECONDS=3600
WORKBENCH_SANDBOX_MAX_COMMAND_SECONDS=120
WORKBENCH_SANDBOX_REAUTH_SECONDS=300
WORKBENCH_SANDBOX_PROVIDER_TIMEOUT_SECONDS=30
WORKBENCH_SANDBOX_MAX_CODE_CHARS=65536
WORKBENCH_SANDBOX_MAX_COMMAND_CHARS=8192
WORKBENCH_SANDBOX_MAX_OUTPUT_BYTES=1048576
WORKBENCH_SANDBOX_CODE_WORKER_MEMORY_BYTES=536870912
WORKBENCH_SANDBOX_HARD_MAX_FILE_BYTES=10485760
# Production must keep the acceptance harness disabled. It may only be enabled
# in an isolated acceptance deployment with its own mounted token file.
WORKBENCH_DEPLOYMENT_TIER=production
WORKBENCH_SANDBOX_ACCEPTANCE_FAULTS_ENABLED=false
WORKBENCH_SANDBOX_ACCEPTANCE_TOKEN_FILE=/run/secrets/workbench-sandbox/acceptance-token
WORKBENCH_SANDBOX_ACCEPTANCE_REAUTH_SECONDS=300

# random key to encrypt the user password
SECRET_KEY=

# random key for verifying customer account signatures
CUSTOMER_ACCOUNT_SECRET_KEY=

# Service API base URL(no trailing slash!)
SERVICE_API_URL=http://localhost:8000

# Server listen port, not necessarily same with SERVICE_API_URL
SERVER_HTTP_PORT=8000

# Sanic RESPONSE_TIMEOUT for regular (non-streaming) APIs, in seconds.
# Does NOT affect SSE streaming responses once the first chunk is written.
SERVER_RESPONSE_TIMEOUT=300

# Upstream SSE idle timeout in seconds (aiohttp sock_read).
# Triggered when the upstream SSE service stops pushing new chunks for this long.
# 5400s = 90 minutes, aligned with the frontend sendMessage timeout.
SSE_IDLE_TIMEOUT=5400

# Access token expiration time in hours
ACCESS_TOKEN_EXPIRE_HOURS=24

LOG_LEVEL=INFO

# Rate limit configuration in format 'requests/period' (e.g., '100/minute')
RATE_LIMIT=100/minute

# Allowed CORS origins. Multiple origins separated by comma, e.g. 'http://localhost,http://127.0.0.1:3000'
CORS_ORIGINS=http://localhost

# Allowed parent origins for iframe embedding via CSP frame-ancestors. Multiple origins separated by comma.
# Leave empty to only allow same-origin embedding.
# When this is set, auth cookie will be issued as SameSite=None; Secure and CORS credentials will be enabled.
IFRAME_ORIGINS=

# postgresql configuration
PGSQL_HOST=adp-chat-client-db-default
PGSQL_PORT=5432
PGSQL_DB=test
PGSQL_USER=postgres
PGSQL_PASSWORD=ye823hd8euhwf

# COS Object Storage configuration (SecretId/SecretKey reuse TC_SECRET_ID / TC_SECRET_KEY above)
COS_REGION=ap-guangzhou
COS_BUCKET=chat-client-bucket-${TC_SECRET_APPID}
